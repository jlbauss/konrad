//
// markdownlint fixes are code actions, not a formatter, so this applies them on
// save: Markdown normalizes to the house style in .markdownlint.jsonc.
{
  "[markdown]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit"
    }
  }
}
