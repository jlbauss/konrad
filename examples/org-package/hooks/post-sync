#!/usr/bin/env sh
# SPDX-FileCopyrightText: 2026 Jan-Luca Bauß
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Example post-sync hook. konrad runs this HOST-SIDE — cwd is this layer's
# checkout (~/.config/konrad/org/<name>/) — after the layer is cloned
# (`konrad org add`) and after every successful sync (`konrad update` /
# `konrad org sync` / the background refresh). Subscribing to a layer is the
# decision to trust its code: this is the one place org code runs outside
# konrad's sandbox, so keep it small, readable, and idempotent (it runs on
# every sync, changed or not).
#
# konrad exports a small contract (since 0.23):
#   KONRAD_NOTICE_DIR        drop `key: value` notice files here; konrad renders
#                            them (attributed to this layer, sanitized) at the
#                            member's NEXT launch — the channel for news the
#                            unwatched background sync would otherwise bury
#   KONRAD_LAYER_NAME        this layer's installed name
#   KONRAD_HOOK_INTERACTIVE  1 on add/sync/update, 0 under the background worker
#
# Typical jobs — the ~10% an org can't express as plain config:
#   - mirror a reference corpus (wiki export, internal docs) into
#     ~/.config/konrad/context/<name>/ for the agent to grep at /context/<name>
#   - derive per-member identity from the org's own auth (glab/gh api) and
#     write it as an instructions/ file INSIDE this layer
#
# This example does a safe, visible no-op variant of the corpus-mirror job:
# it stamps a marker file into context/ so you can watch the mechanism work,
# and — when the member's forge sign-in has expired — tells them, in their own
# terms, through the notice channel. Replace it with your real logic (rsync,
# git clone --depth 1, an API call, …) or delete hooks/ entirely if your org
# needs none.
set -eu

KONRAD_HOME="${KONRAD_CFG_DIR:-$HOME/.config/konrad}"
CORPUS_DIR="$KONRAD_HOME/context/acme-example"

# emit_notice SEVERITY SUMMARY [FIX] — drop a notice, if this konrad supports it
# (guarded on KONRAD_NOTICE_DIR so the hook still runs on pre-0.23 konrad).
emit_notice() {
  [ -n "${KONRAD_NOTICE_DIR:-}" ] || return 0
  { printf 'severity: %s\n' "$1"
    printf 'summary: %s\n' "$2"
    [ -n "${3:-}" ] && printf 'fix: %s\n' "$3"
  } > "$KONRAD_NOTICE_DIR/corpus-sync"
}

# Real hooks fetch here (e.g. `glab api …` / `rsync …`). If the member's forge
# auth has expired, the corpus silently freezes — exactly the case worth
# surfacing. Sketch:
#   if ! glab auth status >/dev/null 2>&1; then
#     emit_notice blocked \
#       "the ACME corpus can't refresh — your GitLab sign-in has expired" \
#       "glab auth login --hostname gitlab.example.com --web"
#     exit 1
#   fi

mkdir -p "$CORPUS_DIR"
printf 'synced %s from %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(pwd)" \
  > "$CORPUS_DIR/last-sync.txt"
echo "post-sync: example corpus marker refreshed at $CORPUS_DIR"
